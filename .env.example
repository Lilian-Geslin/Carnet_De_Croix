# Modèle de fichier .env : copie ce fichier en « .env » (à la racine, à côté de run.py) puis remplis les valeurs.
# Le vrai .env ne doit JAMAIS être envoyé sur Git (il est dans .gitignore). Vérification : python scripts/check_env.py

# --- Obligatoire ---------------------------------------------------------------
# Clé qui signe les sessions (16 caractères minimum, 32+ conseillés). Génération :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CARNET_SECRET_KEY=

# --- Sur ton PC uniquement (jamais sur le serveur) -----------------------------
# Désactive le HTTPS forcé et le cookie « secure » pour travailler en http://127.0.0.1:5000
CARNET_ENV=development

# --- Sur le serveur uniquement -------------------------------------------------
# TRUST_PROXY=1            # lit la vraie adresse IP du visiteur (limitation des tentatives) derrière un proxy

# --- Comptes (facultatif) -------------------------------------------------------
# ALLOW_REGISTRATION=0     # 0 = inscriptions fermées (instance personnelle : crée ton compte d'abord)
# CARNET_ADMIN_EMAIL=      # seul compte à pouvoir sauvegarder / restaurer la base (défaut : le premier compte créé)

# --- Autres réglages (facultatifs, valeurs par défaut entre parenthèses) -------
# CARNET_DATABASE=         # chemin de la base SQLite (défaut : carnet.db à la racine)
# CARNET_MAX_UPLOAD_MB=256 # taille maximale d'un envoi (PDF de topo, restauration)
# FORCE_HTTPS=1            # 0 = pas de redirection http -> https en production
